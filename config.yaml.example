server:
  host: 127.0.0.1
  port: 8000

database:
  backend: sqlite

  # ── auto 模式：自動判別檔案類型（SQLite / DBF / MDB / ACCDB；MDF 請用 sqlserver）──
  # backend: auto
  # file: data/sample.dbf          # 資料庫檔案路徑
  # table: Members                 # SQLite / Access 需指定資料表（DBF 為單表格式免設定）
  # encoding: utf-8                # DBF 編碼：utf-8 或 big5 (cp950)

  sqlite:
    path: instance/demo.db
    table: Members
  sqlserver:
    host: 127.0.0.1
    port: 1433
    user: sa
    password: "YourStrong!Passw0rd"
    database: MemberData
    table: dbo.Members

search:
  page_size: 20
  columns:
    name: null
    idcard: null
    address: null
    phone: null
